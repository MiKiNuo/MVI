<UserControl
    x:Class="MiKiNuo.Mvi.Samples.Avalonia.Features.ResetPassword.ResetPasswordView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Width="420"
        Padding="32"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <StackPanel Spacing="14">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                Text="重置密码" />
            <TextBox
                PlaceholderText="用户名"
                Text="{Binding UserName, Mode=TwoWay}" />
            <TextBox
                PasswordChar="*"
                PlaceholderText="新密码"
                Text="{Binding NewPassword, Mode=TwoWay}" />
            <TextBox
                PasswordChar="*"
                PlaceholderText="确认新密码"
                Text="{Binding ConfirmPassword, Mode=TwoWay}" />
            <TextBlock
                FontSize="12"
                Foreground="#DC2626"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding SubmitCommand}"
                Content="重置密码"
                IsEnabled="{Binding CanSubmit}" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding GoLoginCommand}"
                    Content="返回登录" />
            </StackPanel>
            <Panel
                Background="#CCFFFFFF"
                IsVisible="{Binding IsBusy}"
                ZIndex="10">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <ProgressBar Width="160" IsIndeterminate="True" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#475569"
                        HorizontalAlignment="Center"
                        Text="重置中..." />
                </StackPanel>
            </Panel>
        </Grid>
    </Border>
</UserControl>
