<UserControl
    x:Class="MiKiNuo.Mvi.Samples.Avalonia.Features.Home.HomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Width="420"
        Padding="32"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="14">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                Text="主页" />
            <TextBlock FontSize="14" Foreground="#475569">
                <Run Text="欢迎你，" />
                <Run FontWeight="SemiBold" Text="{Binding DisplayName}" />
            </TextBlock>
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding LogoutCommand}"
                Content="退出登录" />
        </StackPanel>
    </Border>
</UserControl>
