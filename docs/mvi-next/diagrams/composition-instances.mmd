classDiagram
    direction TB

    class Workspace {
        <<instance>>
        +WorkspaceFeature
        +InstanceId
        +RequestCloseAsync()
        +Close()
        +CloseTicket.Released
    }
    class WorkspaceStore {
        <<instance>>
        +WorkspaceState
        +OperationStates
        +FeatureStore.gate
    }
    class WorkspaceView {
        <<instance>>
        +FeatureProjection
        +Unmount()
    }
    class EditorA {
        <<instance>>
        +EditorFeature
        +InstanceId A
        +EditorPortA
    }
    class StoreA {
        <<instance>>
        +StateA
        +OperationsA
        +GateA
    }
    class EditorViewA {
        <<instance>>
        +FeatureProjection A
        +Unmount()
    }
    class EditorB {
        <<instance>>
        +EditorFeature
        +InstanceId B
        +EditorPortB
    }
    class StoreB {
        <<instance>>
        +StateB
        +OperationsB
        +GateB
    }
    class EditorViewB {
        <<instance>>
        +FeatureProjection B
        +Unmount()
    }
    class Mediator {
        <<instance>>
        +Register(RequestPort)
    }

    Workspace "1" *-- "1" WorkspaceStore : 本实例内核
    Workspace "1" *-- "1" EditorA : 拥有与关闭
    Workspace "1" *-- "1" EditorB : 拥有与关闭
    EditorA "1" *-- "1" StoreA : 独立运行内核
    EditorB "1" *-- "1" StoreB : 独立运行内核
    WorkspaceView ..> Workspace : 卸载只解绑
    WorkspaceView o-- EditorViewA : 视觉挂载
    WorkspaceView o-- EditorViewB : 视觉挂载
    EditorViewA ..> EditorA : 卸载只解绑
    EditorViewB ..> EditorB : 卸载只解绑
    Workspace ..> Mediator : 地址与契约接线
    EditorA ..> Mediator : 定向请求 editorB
    Mediator ..> EditorA : editorA / EditorPortA
    Mediator ..> EditorB : editorB / EditorPortB
