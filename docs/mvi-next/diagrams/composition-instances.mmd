classDiagram
    direction TB

    class Workspace {
        <<instance>>
        +WorkspaceFeature
        +Address workspace
        +Guard()
        +LogicalClose()
        +Drain()
    }
    class WorkspaceRuntime {
        <<instance>>
        +WorkspaceState
        +WorkspaceOperations
        +WorkspaceGate
    }
    class WorkspaceView {
        <<instance>>
        +LocalBindings
        +Unmount()
    }
    class EditorA {
        <<instance>>
        +EditorFeature
        +Address editorA
        +EditorPortA
    }
    class RuntimeA {
        <<instance>>
        +StateA
        +OperationsA
        +GateA
    }
    class EditorViewA {
        <<instance>>
        +BindingsA
        +Unmount()
    }
    class EditorB {
        <<instance>>
        +EditorFeature
        +Address editorB
        +EditorPortB
    }
    class RuntimeB {
        <<instance>>
        +StateB
        +OperationsB
        +GateB
    }
    class EditorViewB {
        <<instance>>
        +BindingsB
        +Unmount()
    }
    class Mediator {
        <<instance>>
        +ExplicitTargets
    }

    Workspace "1" *-- "1" WorkspaceRuntime : 本实例内核
    Workspace "1" *-- "1" EditorA : 拥有与关闭
    Workspace "1" *-- "1" EditorB : 拥有与关闭
    EditorA "1" *-- "1" RuntimeA : 独立运行内核
    EditorB "1" *-- "1" RuntimeB : 独立运行内核
    WorkspaceView ..> Workspace : 卸载只解绑
    WorkspaceView o-- EditorViewA : 视觉挂载
    WorkspaceView o-- EditorViewB : 视觉挂载
    EditorViewA ..> EditorA : 卸载只解绑
    EditorViewB ..> EditorB : 卸载只解绑
    Workspace ..> Mediator : 地址与契约接线
    EditorA ..> Mediator : 定向请求 editorB
    Mediator ..> EditorA : editorA / EditorPortA
    Mediator ..> EditorB : editorB / EditorPortB
