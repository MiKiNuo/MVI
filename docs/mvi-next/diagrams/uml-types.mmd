classDiagram
    direction TB
    class Feature~TState~ {
        <<公开业务基类>>
        +Snapshot
        +DispatchInput(value, reduce)
        +DispatchOperation(name, validate, execute)
    }
    class FeatureStore~TState~ {
        <<内部实例内核>>
        -gate
        -snapshot
        +Dispatch(intent)
        +Start(operation)
        -Reduce(snapshot, intent)
        -ExecuteAsync(operation, execute)
    }
    class RuntimeSnapshot~TState~ {
        +TState State
        +OperationStates
        +long Version
    }
    class InputIntent~TState_TValue~ {
        <<内部强类型输入>>
        +Reduce(state)
    }
    class OperationStartIntent~TState_TResult~ {
        <<内部启动描述>>
        +Name
        +Guid Id
        +Validate
        +Execute
    }
    class OperationEffect~TState_TResult~ {
        <<内部执行描述>>
        +Request
        +TState Input
    }
    class OperationReduction~TState_TResult~ {
        <<内部操作计算结果>>
        +Snapshot
        +Result
        +Effect
        +Decision
    }
    class Operation~TState~ {
        <<公开执行上下文>>
        +TState Snapshot
        +CancellationToken
        +UpdateAsync(reducer, payload)
        +Track(task)
    }
    class FeatureProjection~TState~ {
        <<本地展示基类>>
        +Snapshot
        +PropertyChanged
        +Dispose()
    }
    class Mediator {
        +Register(port)
        +SendAsync(request, target)
        +Post(message, target)
    }
    class RequestPort~TRequest_TResult~ {
        +Deactivate()
    }
    Feature~TState~ "1" *-- "1" FeatureStore~TState~ : 独立内核
    FeatureStore~TState~ "1" *-- "1" RuntimeSnapshot~TState~ : 当前快照
    FeatureStore~TState~ ..> InputIntent~TState_TValue~ : 纯输入转换
    FeatureStore~TState~ ..> OperationStartIntent~TState_TResult~ : 门内验证与接纳
    FeatureStore~TState~ ..> OperationReduction~TState_TResult~ : Reduce 返回
    OperationReduction~TState_TResult~ o-- OperationEffect~TState_TResult~ : 可选 Effect
    OperationEffect~TState_TResult~ --> OperationStartIntent~TState_TResult~ : 已接纳请求
    FeatureStore~TState~ ..> Operation~TState~ : 门外执行上下文
    Operation~TState~ ..> FeatureStore~TState~ : FeedbackIntent 回流
    FeatureProjection~TState~ ..> Feature~TState~ : 本地输入与快照
    Mediator ..> RequestPort~TRequest_TResult~ : 明确目标
    RequestPort~TRequest_TResult~ ..> Feature~TState~ : 目标操作入口
