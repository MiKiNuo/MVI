flowchart TB
    UI["View 交互 / 系统输入"] --> I["生成 SetInput / 操作入口<br/>强类型 Intent"]
    subgraph M["FeatureStore · 单实例 Model"]
        E["Dispatch / Start<br/>验证、准入与有效性"] --> R["纯 Reduce 重载<br/>当前 Snapshot + Intent"]
        R --> N["RuntimeSnapshot / OperationReduction<br/>快照、决定与可选 OperationEffect"]
        N --> C["原子提交<br/>State / OperationStates / Version"]
    end
    I --> E
    C --> V["生成 FeatureProjection<br/>平台本地更新与展示合并"]
    N -->|"提交后，门外"| X["FeatureStore.ExecuteAsync<br/>Operation 上下文执行业务"]
    X --> S["网络 / 文件 / UI 服务 / Mediator"]
    S --> F["反馈与完成 Intent<br/>有效性核对后提交"]
    F --> E
    O["Operation.UpdateAsync<br/>纯转换 + 不可变载荷"] -->|"FeedbackIntent"| E
    T["Mediator 定向 RequestPort"] -->|"复用目标操作入口"| E
