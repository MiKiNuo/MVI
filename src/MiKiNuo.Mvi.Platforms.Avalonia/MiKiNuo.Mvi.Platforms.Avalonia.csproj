<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>MiKiNuo.Mvi.Platforms.Avalonia</PackageId>
    <Description>MiKiNuo MVI 框架的 Avalonia 平台入口包，包含平台适配，并通过 NuGet 依赖自动引入唯一的生成器包。</Description>
    <PackageTags>mvi;r3;avalonia;source-generator;analyzer;clean-architecture;mediator;di</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiKiNuo.Mvi.Runtime\MiKiNuo.Mvi.Runtime.csproj" />
    <ProjectReference Include="..\MiKiNuo.Mvi.Binding\MiKiNuo.Mvi.Binding.csproj" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <None Update="buildTransitive\MiKiNuo.Mvi.Platforms.Avalonia.targets" Pack="true" PackagePath="buildTransitive\MiKiNuo.Mvi.Platforms.Avalonia.targets" />
  </ItemGroup>
</Project>
