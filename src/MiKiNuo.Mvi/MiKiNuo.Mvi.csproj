<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>MiKiNuo.Mvi</PackageId>
    <Description>Platform-independent MVI runtime with compile-time feature generation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../MiKiNuo.Mvi.Generators/MiKiNuo.Mvi.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="../MiKiNuo.Mvi.Generators/bin/$(Configuration)/netstandard2.0/MiKiNuo.Mvi.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>
</Project>
